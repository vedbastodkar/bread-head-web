# ─────────────────────────────────────────────────────────────
# Bread Head Web — environment
# Copy to .env.local and fill the TODOs. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────

# Existing (marketing site)
RESEND_API_KEY=re_xxxxxxxxx

# ── Firebase Web SDK (client, browser-exposed — these are NOT secrets) ──
# Project-shared values, transferred from the iOS GoogleService-Info.plist
# (project: bread-head-4b6f9). These are the same across every app in the project.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bread-head-4b6f9.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bread-head-4b6f9
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bread-head-4b6f9.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1072174624694

# App-SPECIFIC values — the iOS key/appId will NOT work for a web app.
# TODO: Firebase console → Project settings → "Your apps" → Add app → Web (</>).
#       That generates the web apiKey + appId below. It's a 1-minute step.
NEXT_PUBLIC_FIREBASE_API_KEY=TODO_web_app_api_key      # generate a Web app key; do not reuse the iOS key
NEXT_PUBLIC_FIREBASE_APP_ID=TODO_1:1072174624694:web:xxxxxxxx

# ── Firebase Admin SDK (server-only — KEEP SECRET, never NEXT_PUBLIC) ──
# Used by app/api/* routes (teacher role claims, privileged Firestore reads/writes).
# TODO: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=bread-head-4b6f9
FIREBASE_ADMIN_CLIENT_EMAIL=TODO_firebase-adminsdk-xxxxx@bread-head-4b6f9.iam.gserviceaccount.com
# Paste the private key with literal \n escapes, wrapped in quotes:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTODO\n-----END PRIVATE KEY-----\n"

# ── Console setup checklist (one-time, outside code) ──
# 1. Add a Web app (above) → paste apiKey + appId.
# 2. Authentication → Sign-in method → enable Email/Password AND Google.
# 3. Authentication → Settings → Authorized domains → add localhost + bread-head.org.
# 4. Google provider reuses web client id 1072174624694-...apps.googleusercontent.com (auto).
